# Copy this file to functions/.env and fill in your real merchant credentials.
# NEVER commit the real .env file to git.

# From your Payme business cabinet (https://business.payme.uz)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# From your Click merchant cabinet (https://merchant.click.uz)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# From @BotFather on Telegram (create a bot, copy the token it gives you)
TELEGRAM_BOT_TOKEN=
